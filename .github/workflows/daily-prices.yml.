name: Daily prices

on:
  schedule:
    # 13:00 UTC, Mon-Fri (9 AM EDT / 8 AM EST)
    - cron: "0 13 * * 1-5"
  workflow_dispatch:

jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install requests
      - run: python prices.py
        env:
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
